name = "wzzc-dev/moui_studio"

version = "0.1.3"

preferred_target = "native"

import {
  "wzzc-dev/moui@0.2.6",
  "wzzc-dev/moui_webview@0.2.6",
  "wzzc-dev/moui_i18n@0.2.6",
  "wzzc-dev/moui_devtools@0.2.6",
  "wzzc-dev/moui_richtext@0.2.6",
  "wzzc-dev/moui_markdown@0.2.6",
  "wzzc-dev/window@0.5.4-0.2.3",
  "wzzc-dev/moui_skia_renderer@0.2.6",
  "wzzc-dev/moui_web_renderer@0.2.6",
  "wzzc-dev/moui_agent@0.2.6",
  "wzzc-dev/moui_agent_mcp@0.2.6",
  "wzzc-dev/moui_cli@0.2.6",
  "moonbitlang/async@0.22.5",
  "moonbitlang/x@0.5.6",
  "Milky2018/wasmoon@0.18.0",
  "Milky2018/wasm_core@0.18.0",
  "Milky2018/wasmoon_runtime@0.18.0",
}

readme = "README.md"

repository = "https://github.com/wzzc-dev/moui_studio.git"

license = "Apache-2.0"

keywords = [
  "moui",
  "studio",
  "ide",
  "gui",
  "skia",
  "low-code",
  "design",
  "code",
]

description = "MoUI Studio: visual + DSL IDE for building MoUI applications"
