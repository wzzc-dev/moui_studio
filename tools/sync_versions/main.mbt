///|
/// 把 Studio 自己 `moon.mod` 的依赖版本同步进
/// `services/export/generated_dependency_versions.mbt`。
///
/// 导出 bundle 与新建工程骨架的 `moon.mod` 必须与 Studio **同版本**：bundle 里
/// 的代码全部从 Studio workspace 拷出，只有依赖去注册表拉，两边一错开就是
/// 「Studio 编得过、导出项目编不过」（实测 pin 旧线 `moui@0.1.12` 时，那一版
/// 自己的源码在新工具链下过不了类型检查，整条 native GUI 构建失败）。
///
/// 旧做法是把版本再抄一遍写进 `export.mbt` 的字符串常量，并由测试断言那组
/// **硬编码字面量**——于是「同源断言」只保证常量等于它自己，Studio bump 到
/// 0.2.3 而生成工程仍 pin 0.2.0 时测试照样绿。本工具把事实源收回一处：
/// 版本只从 `moui_studio/moon.mod` 读，生成表由 `export.mbt` 渲染。
///
/// 与 `tools/sync_kernel` 同款双仓库形态解析（母仓库根 / 独立子仓库根都能跑）：
///
/// ```text
/// # ① MoUI 母仓库根（monorepo）
/// moon run moui_studio/tools/sync_versions --target native -- --check
///
/// # ② moui_studio 独立子仓库根
/// moon run tools/sync_versions --target native -- --check
/// ```

///|
/// 母仓库根形态下的路径前缀（独立子仓库根没有这一级）。
const STUDIO_PREFIX : String = "moui_studio/"

///|
/// 仓库根解析：读与写共用。`path` 按母仓库根书写；若它在当前根下不存在，就
/// 试去掉/补上 `moui_studio/` 前缀的另一种形态。都不存在时原样返回，由调用方
/// 的错误路径发声——永不静默写到别的仓库。
fn resolve_repo_path(path : String) -> String {
  if @x/fs.path_exists(path) {
    return path
  }
  let alt = if path.has_prefix(STUDIO_PREFIX) {
    path[STUDIO_PREFIX.length():].to_owned()
  } else {
    "\{STUDIO_PREFIX}\{path}"
  }
  if @x/fs.path_exists(alt) {
    return alt
  }
  path
}

///|
/// 取路径的目录部分（最后一个 `/` 之前；没有 `/` 返回空串）。
fn dir_of(path : String) -> String {
  match path.rev_find("/") {
    Some(slash) => path[:slash].to_owned()
    None => ""
  }
}

///|
/// 写路径解析：按**目录**判定根形态（输出文件可能尚未生成，按文件判定会在
/// 首次生成时落到错的仓库），再把文件名拼回已解析的目录。
fn resolve_write_path(path : String) -> String {
  let dir = dir_of(path)
  let resolved = resolve_repo_path(dir)
  if resolved == dir {
    return path
  }
  resolved + path[dir.length():].to_owned()
}

///|
/// 事实源：Studio 自己的模块清单。
fn studio_manifest_path() -> String {
  "moui_studio/moon.mod"
}

///|
/// 生成物落点（services/export 包内的常量表）。
fn output_path() -> String {
  "moui_studio/services/export/generated_dependency_versions.mbt"
}

///|
/// 导出工程实际需要的依赖面（顺序 = 导出 `moon.mod` 的 import 块顺序）。
/// Studio 的依赖是这张表的超集——IDE 侧包（webview/i18n/devtools/…）不进导出
/// 工程，所以这里按名白名单取，而不是全量搬运。
fn bundle_dependency_paths() -> Array[String] {
  [
    "wzzc-dev/moui", "wzzc-dev/window", "wzzc-dev/moui_skia_renderer", "wzzc-dev/moui_web_renderer",
    "moonbitlang/async", "moonbitlang/x",
  ]
}

///|
/// 从 Studio moon.mod 文本取依赖版本表；任一必需依赖缺席 = 结构化报错。
fn dependency_table(
  manifest_source : String,
) -> Result[Array[(String, String)], String] {
  match @scan.parse_module_manifest(manifest_source) {
    Err(message) => Err(message)
    Ok(manifest) => {
      let table : Array[(String, String)] = []
      for path in bundle_dependency_paths() {
        let mut version = ""
        for dep in manifest.imports {
          if dep.path == path {
            version = dep.version
          }
        }
        if version == "" {
          return Err(
            "\{studio_manifest_path()} 里没有依赖 \{path}——导出工程的依赖面与 IDE 漂开了",
          )
        }
        table.push((path, version))
      }
      Ok(table)
    }
  }
}

///|
/// 生成物文本。前三行带 DO NOT EDIT：维护基线按前 3 行识别 generated 文件。
fn output_text(table : Array[(String, String)]) -> String {
  let mut out = "/// DO NOT EDIT — generated by tools/sync_versions.\n" +
    "/// 导出 bundle / 新建工程骨架的依赖版本表，事实源是 moui_studio/moon.mod。\n" +
    "/// 漂开时 `moon run moui_studio/tools/sync_versions --target native -- --check` 报 DRIFT。\n" +
    "\n///|\n" +
    "/// 依赖模块路径 → 版本（顺序即导出 `moon.mod` 的 import 块顺序）。\n" +
    "pub fn bundle_dependency_versions() -> Array[(String, String)] {\n  [\n"
  for pair in table {
    let (path, version) = pair
    out = out + "    (\"\{path}\", \"\{version}\"),\n"
  }
  out + "  ]\n}\n"
}

///|
/// 读事实源并生成文本。读不到 = 结构化 Err（不 raise，调用方只需处理一种错误）。
fn render() -> Result[String, String] {
  let source = @x/fs.read_file_to_string(
    resolve_repo_path(studio_manifest_path()),
  ) catch {
    _ => return Err("读不到事实源：\{studio_manifest_path()}")
  }
  match dependency_table(source) {
    Err(message) => Err(message)
    Ok(table) => Ok(output_text(table))
  }
}

///|
fn check_mode() -> Int32 {
  let expected = match render() {
    Err(message) => {
      println("version sync failed: \{message}")
      return 1
    }
    Ok(text) => text
  }
  let output = resolve_write_path(output_path())
  if !@x/fs.path_exists(output) {
    println("MISSING \{output}（尚未同步）")
    return 1
  }
  let current = @x/fs.read_file_to_string(output) catch { _ => "" }
  if current == expected {
    println("export dependency versions: current")
    0
  } else {
    println(
      "DRIFT \{output}：与 Studio moon.mod 不一致。请运行 moon run tools/sync_versions --target native",
    )
    1
  }
}

///|
fn write_mode() -> Int32 raise {
  let expected = match render() {
    Err(message) => {
      println("version sync failed: \{message}")
      return 1
    }
    Ok(text) => text
  }
  let output = resolve_write_path(output_path())
  @x/fs.write_string_to_file(output, expected)
  println("synced: \{output}")
  0
}

///|
fn main {
  let args = @env.args()
  let code = try {
    if args.length() > 1 && args[1] == "--check" {
      check_mode()
    } else {
      write_mode()
    }
  } catch {
    err => {
      println("sync failed: \{err}")
      1
    }
  }
  if code != 0 {
    @sys.exit(code)
  }
}
