///|
/// 把 MoUI Studio domain 包的领域内核源码同步进 `services/export/` 的
/// `kernel_ir.mbt` / `kernel_studio_lang.mbt` / `kernel_codec.mbt` 常量文件，
/// 并把 runner 模板同步进 `kernel_runner.mbt`。
///
/// 导出的可执行应用需要自带一份内核（导出项目只能依赖已发布模块，不能 import
/// `moui_studio/domain/*`）。本工具把 3 个领域包的全部 .mbt + runner 模板逐字节
/// 读入并写成常量（每个源文件一个常量函数）；`export_test` 的漂移测试保证
/// 「改了内核忘同步」会失败。
///
/// 路径按 **MoUI 母仓库根** 书写（带 `moui_studio/` 前缀），但本工具在两种
/// 仓库形态下都能跑——独立子仓库克隆里 `moui_studio/` 前缀那一级不存在：
///
/// ```text
/// # ① MoUI 母仓库根（monorepo）
/// moon run moui_studio/tools/sync_kernel --target native -- --check
///
/// # ② moui_studio 独立子仓库根
/// moon run tools/sync_kernel --target native -- --check
/// ```
///
/// 解析规则见 `resolve_repo_path`：两种形态下同一路径只有一个候选真实存在，
/// 因此无歧义；都不存在时原样返回，读失败报 MISSING、写失败是显式 IOError，
/// 永不静默写到别的仓库。

///|
/// 母仓库根形态下的路径前缀（独立子仓库根没有这一级）。
const STUDIO_PREFIX : String = "moui_studio/"

///|
/// 仓库根解析：读与写共用。`path` 按母仓库根书写；若它在当前根下不存在，就
/// 试去掉/补上 `moui_studio/` 前缀的另一种形态。输出文件与领域源文件都已入
/// 库，所以两种形态下都能命中；命中不了时原样返回，由调用方的错误路径发声。
fn resolve_repo_path(path : String) -> String {
  if @x/fs.path_exists(path) {
    return path
  }
  let alt = if path.has_prefix(STUDIO_PREFIX) {
    path[STUDIO_PREFIX.length():].to_owned()
  } else {
    "\{STUDIO_PREFIX}\{path}"
  }
  if @x/fs.path_exists(alt) {
    return alt
  }
  path
}

///|
/// 取路径的目录部分（最后一个 `/` 之前；没有 `/` 返回空串）。
/// `String::substring` 已废弃（改用切片语法）；`rev_find` 给最后一个分隔符。
fn dir_of(path : String) -> String {
  match path.rev_find("/") {
    Some(slash) => path[:slash].to_owned()
    None => ""
  }
}

///|
/// 写路径解析：按**目录**判定根形态（输出文件可能尚未生成，按文件判定会在
/// 首次生成时落到错的仓库），再把文件名拼回已解析的目录。目录也找不到时
/// 原样返回——写失败是显式 IOError，不静默。
fn resolve_write_path(path : String) -> String {
  let dir = dir_of(path)
  let resolved = resolve_repo_path(dir)
  if resolved == dir {
    return path
  }
  resolved + path[dir.length():].to_owned()
}

///|
/// 参与导出的内核文件（单一事实来源，顺序即写入顺序）。
/// 输出文件名 → [(常量名, 源文件相对路径)]。
fn kernel_files() -> Array[(String, Array[(String, String)])] {
  [
    (
      "kernel_ir",
      [
        ("kernel_ir_mbt", "moui_studio/domain/ir/ir.mbt"),
        ("kernel_ir_invariants_mbt", "moui_studio/domain/ir/invariants.mbt"),
        ("kernel_ir_signature_mbt", "moui_studio/domain/ir/signature.mbt"),
      ],
    ),
    (
      "kernel_studio_lang",
      [
        (
          "kernel_studio_lang_aliases_mbt", "moui_studio/domain/studio_lang/aliases.mbt",
        ),
        (
          "kernel_studio_lang_errors_mbt", "moui_studio/domain/studio_lang/errors.mbt",
        ),
        (
          "kernel_studio_lang_keywords_mbt", "moui_studio/domain/studio_lang/keywords.mbt",
        ),
        (
          "kernel_studio_lang_lexer_mbt", "moui_studio/domain/studio_lang/lexer.mbt",
        ),
        (
          "kernel_studio_lang_parser_mbt", "moui_studio/domain/studio_lang/parser.mbt",
        ),
      ],
    ),
    (
      "kernel_studio_lang_rt",
      [
        (
          "kernel_studio_lang_printer_mbt", "moui_studio/domain/studio_lang/printer.mbt",
        ),
        (
          "kernel_studio_lang_interp_mbt", "moui_studio/domain/studio_lang/interp.mbt",
        ),
        (
          "kernel_studio_lang_semantics_mbt", "moui_studio/domain/studio_lang/semantics.mbt",
        ),
      ],
    ),
    (
      "kernel_codec",
      [("kernel_codec_mbt", "moui_studio/domain/codec/codec.mbt")],
    ),
    (
      "kernel_compiled_runtime",
      [
        (
          "kernel_compiled_runtime_mbt", "moui_studio/services/compiled_runtime/runtime.mbt",
        ),
      ],
    ),
  ]
}

///|
/// 导出的可执行 runner 模板（不在任何 package 内，仅作为文本同步）。
fn runner_template_path() -> String {
  "moui_studio/tools/export_runner_template/runner.mbt"
}

///|
/// 把一行源码包装成 `#|` 前缀的多行字符串行。
/// 注意：本工具链的 `#|` 多行串**不做插值**（`\{x}` 原样输出），所以源码行
/// 必须原样嵌入——任何额外转义都会把内核里的插值语法写成字面量，静默改变语义
/// （历史上就这样让校验器的占用键全部退化成同一个字符串）。
fn embed_line(line : String) -> String {
  "    #|\{line}"
}

///|
/// 生成一个返回源码的 pub 函数。前置一个空行，使多个常量相邻时也符合 moon fmt。
fn constant_block(name : String, source : String) -> String {
  let mut out = "\n///|\npub fn \{name}() -> String {\n  let source =\n"
  for view in source.split("\n") {
    out = out + embed_line(view.to_owned()) + "\n"
  }
  out + "  source\n}\n"
}

///|
/// 单个输出文件路径（与 domain 包名对应：kernel_ir.mbt 等）。
fn constant_output(name : String) -> String {
  "moui_studio/services/export/\{name}.mbt"
}

///|
/// 一个领域包的全部常量：文件头 + 每个源文件一个 constant_block。
fn group_output_text(
  output_name : String,
  entries : Array[(String, String)],
) -> String raise {
  // 首三行带 DO NOT EDIT：维护基线的 generated 判定按前 3 行识别
  // 生成文件，内核镜像不应受超大文件阈值约束（行数由棘轮管理）。
  let mut out = "/// DO NOT EDIT — generated by tools/sync_kernel.\n/// \{output_name}：domain 下若干 .mbt 的逐字节副本。\n/// 由 tools/sync_kernel 生成，勿手改；与源文件不一致时\n/// `moon run moui_studio/tools/sync_kernel --target native -- --check` 会报 DRIFT。\n"
  for entry in entries {
    out = out +
      constant_block(
        entry.0,
        @x/fs.read_file_to_string(resolve_repo_path(entry.1)),
      )
  }
  out
}

///|
/// runner 模板常量的输出文本。
fn runner_output_text() -> String raise {
  "///|\n/// 导出的可执行 runner 源码（由 tools/sync_kernel 生成，勿手改）。\n/// 模板位于 tools/export_runner_template/runner.mbt；\n/// 模板改动不同步时 `--check` 会报 DRIFT。\n" +
  constant_block(
    "runner_source",
    @x/fs.read_file_to_string(resolve_repo_path(runner_template_path())),
  )
}

///|
fn all_outputs() -> Array[(String, String)] raise {
  let out : Array[(String, String)] = []
  for group in kernel_files() {
    out.push((constant_output(group.0), group_output_text(group.0, group.1)))
  }
  out.push((constant_output("kernel_runner"), runner_output_text()))
  out
}

///|
fn check_mode() -> Int raise {
  let mut ok = true
  for pair in all_outputs() {
    let output = resolve_write_path(pair.0)
    let current = @x/fs.read_file_to_string(output) catch {
      _ => {
        println("MISSING \{output}（尚未同步）")
        ok = false
        continue
      }
    }
    if current != pair.1 {
      println(
        "DRIFT \{output}：与源文件不一致。请运行 moon run tools/sync_kernel --target native",
      )
      ok = false
    }
  }
  if ok {
    println("export kernel sync: current")
    0
  } else {
    1
  }
}

///|
fn write_mode() -> Int raise {
  let mut count = 0
  for pair in all_outputs() {
    let output = resolve_write_path(pair.0)
    @x/fs.write_string_to_file(output, pair.1)
    count = count + 1
  }
  println("synced: \{count} files")
  0
}

///|
fn main {
  let args = @env.args()
  let code = try {
    if args.length() > 1 && args[1] == "--check" {
      check_mode()
    } else {
      write_mode()
    }
  } catch {
    err => {
      println("sync failed: \{err}")
      1
    }
  }
  if code != 0 {
    @sys.exit(code)
  }
}
